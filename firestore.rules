rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────────────────────────────────
    // Any authenticated user may read profiles (needed for user search).
    // Only the owner may write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public key bundles ─────────────────────────────────────────────────────
    // Any authenticated user may read key bundles (needed for X3DH key exchange).
    // Only the owner may write their own key bundle.
    match /keyBundles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Conversations ──────────────────────────────────────────────────────────
    // Read / update / delete: caller must be in participantIds.
    // Create: caller must include themselves in participantIds (resource doesn't
    //         exist yet, so we check request.resource.data instead).
    match /conversations/{conversationId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;

      // ── Messages ─────────────────────────────────────────────────────────────
      // Caller must be a participant of the parent conversation.
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participantIds;
      }
    }

    // ── Call signals ───────────────────────────────────────────────────────────
    // Any authenticated user may create a call document.
    // Only the caller or recipient may read or update it.
    match /calls/{callId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.recipientId);

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Message requests ───────────────────────────────────────────────────────
    // Only sender or recipient may read/write the request document.
    match /messageRequests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.recipientId);
    }
  }
}
